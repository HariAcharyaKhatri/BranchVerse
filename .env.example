# BranchVerse Frontend Environment Configuration Template
# -------------------------------------------------------------
# Copy this file to `.env.local` to configure your local environment.
#
# IMPORTANT SECURITY NOTICE:
# Variables prefixed with `VITE_` are bundled into the public client application bundle.
# NEVER place server-only secrets, service account JSONs, or private API keys here.
# Firebase Web App configuration values below are public client identifiers intended for browser SDKs.

VITE_APP_NAME="BranchVerse"
VITE_APP_TAGLINE="Your Choices. Your World. Your Story."

# -------------------------------------------------------------
# FIREBASE AUTHENTICATION (Google Sign-In)
# -------------------------------------------------------------
# Obtain these values from the Firebase Console:
# 1. Open https://console.firebase.google.com/ and select your project.
# 2. Click Project Settings (gear icon) > General > "Your apps" > Web app (</>).
# 3. Copy the configuration properties into `.env.local` below:

VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# -------------------------------------------------------------
# REQUIRED FIREBASE CONSOLE CONFIGURATION STEPS:
# -------------------------------------------------------------
# 1. Enable Google Sign-In Provider:
#    Go to Firebase Console > Authentication > Sign-in method > Google > Enable > Save.
#
# 2. Authorized Domains:
#    Go to Firebase Console > Authentication > Settings > Authorized domains.
#    - For local development: ensure `localhost` is present (default).
#      (CRITICAL: Do NOT include http:// or port numbers; use `localhost` only).
#    - For production deployment: add your custom production domain (e.g., `branchverse.com` or `your-app.web.app`).
#
# -------------------------------------------------------------
# SERVER-SIDE GEMINI AI NARRATIVE ENGINE
# -------------------------------------------------------------
# NOTE: These variables are used by the backend ONLY.
# NEVER prefix GEMINI_API_KEY with VITE_ or expose it to client bundles!
#
# In Local Development: place GEMINI_API_KEY in .env.local
# In Production (Vercel): configure GEMINI_API_KEY in Vercel Project Settings > Environment Variables
GEMINI_API_KEY=""
GEMINI_INITIAL_MODEL="gemini-3.8-flash"
GEMINI_TURN_MODEL="gemini-3.1-flash-lite"
AI_ENABLED="true"

# Note: If these Firebase variables are left blank, BranchVerse automatically
# runs in Guest/Demo Mode without crashing, allowing full offline story creation.
