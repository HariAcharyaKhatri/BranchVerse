{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/narrative/initial",
      "destination": "/api/narrative/initial"
    },
    {
      "source": "/api/narrative/turn",
      "destination": "/api/narrative/turn"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
